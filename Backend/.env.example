# Database connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT / Session Secret (minimum 32 characters for security)
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"

# Environment
NODE_ENV="development"

# Server Port
PORT=3000

# Backend Origin / App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
