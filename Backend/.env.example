# Database connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT / Session Secret (minimum 32 characters for security)
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"

# Dedicated OTP Secret (Optional; minimum 32 characters. Falls back to JWT_SECRET if unset)
# Note: Rotating OTP_SECRET immediately invalidates any outstanding pending OTP challenges.
# OTP_SECRET="replace-with-a-dedicated-secret-at-least-32-chars-long"

# Environment
NODE_ENV="development"

# Server Port
PORT=3000

# Backend Origin / App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMS Delivery Provider Configuration
# Production uses Twilio Verify as preferred provider for international and Indian customer OTP delivery.
#
# Production Requirements:
# 1. Twilio Account SID & Auth Token (from Twilio Console: https://console.twilio.com)
# 2. Twilio Account Upgrade: Trial accounts are restricted to pre-verified numbers (Verified Caller IDs).
#    Upgrading and adding a payment method immediately enables delivery to ANY customer phone number.
# 3. Twilio Verify Service SID: Created under Twilio Console -> Verify -> Services (friendly name: e.g. "Restrauque Auth").
# 4. India SMS Geo-Permissions: Enable India (+91) under Messaging -> Settings -> Geo Permissions in Twilio Console.
# 5. DLT Compliance: Twilio Verify handles TRAI/DLT pre-approved template routing automatically for OTPs.
#
SMS_PROVIDER="twilio" # Options: twilio | mock
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_VERIFY_SERVICE_SID="VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" # Preferred: Twilio Verify Service SID
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX" # Fallback: Only required if using Twilio Programmable Messages without Verify Service

# Cloudinary Product Image Storage
# Obtain these credentials from your Cloudinary Dashboard: https://console.cloudinary.com/
# Once set in .env, restart the Next.js backend server (`npm run dev`) for the changes to take effect.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# Order Completion Notification Configuration (Step 5)
# 1. Programmable SMS for Order Completion & Feedback Deep Links:
#    - Twilio Messaging Service SID or Twilio Phone Number required for sending transactional SMS alerts.
#    - Sender must have carrier approvals/templates for order confirmation and feedback links.
# TWILIO_MESSAGING_SERVICE_SID="MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" # Optional Twilio Messaging Service
#
# 2. Email Notification Provider (Optional / Pluggable):
#    - Used for delivering completion notifications if customer has an email associated.
#    - Unset/empty gracefully skips email dispatch without interrupting order completion.
# EMAIL_PROVIDER="standard" # Options: standard | mock
# RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXX"
# EMAIL_FROM="Restrauque Orders <orders@yourverifieddomain.com>"

# Internal Scheduled Trigger & Recovery Secret (Step 7.7)
# Used to authenticate automated background workers, AWS EventBridge API destinations,
# CloudWatch crons, or container sweepers calling /api/v1/internal/* endpoints.
# Must be a secure random secret at least 32 characters long.
INTERNAL_API_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
