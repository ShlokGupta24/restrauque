generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_agent_actions {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_run_id      String            @db.Uuid
  restaurant_id     String            @db.Uuid
  branch_id         String?           @db.Uuid
  action_type       String            @db.VarChar(50)
  target_type       String?           @db.VarChar(50)
  target_id         String?           @db.Uuid
  status            String            @default("pending") @db.VarChar(20)
  requires_approval Boolean           @default(false)
  approved_by       String?           @db.Uuid
  approved_at       DateTime?         @db.Timestamptz(6)
  input_data        Json?
  action_data       Json?
  result_data       Json?
  error_message     String?
  executed_at       DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  restaurant_staff  restaurant_staff? @relation(fields: [approved_by], references: [id], onUpdate: NoAction, map: "fk_ai_agent_actions_approved_by")
  branches          branches?         @relation(fields: [branch_id], references: [id], onUpdate: NoAction, map: "fk_ai_agent_actions_branch")
  restaurants       restaurants       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_agent_actions_restaurant")
  ai_agent_runs     ai_agent_runs     @relation(fields: [agent_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_agent_actions_run")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_agent_runs {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id     String             @db.Uuid
  branch_id         String?            @db.Uuid
  agent_type        String             @db.VarChar(50)
  trigger_type      String             @default("manual") @db.VarChar(30)
  status            String             @default("running") @db.VarChar(20)
  objective         String?
  input_data        Json?
  reasoning_summary String?
  tools_used        Json?
  output_data       Json?
  error_message     String?
  started_at        DateTime           @default(now()) @db.Timestamptz(6)
  completed_at      DateTime?          @db.Timestamptz(6)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  ai_agent_actions  ai_agent_actions[]
  branches          branches?          @relation(fields: [branch_id], references: [id], onUpdate: NoAction, map: "fk_ai_agent_runs_branch")
  restaurants       restaurants        @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_agent_runs_restaurant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_insight_evidence {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
